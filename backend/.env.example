# "test" pendant le développement, "live" une fois vos clés de production actives
PAYDUNYA_MODE=test

# Récupérées dans votre compte PayDunya Business > Intégrez notre API
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# Code d'accès pour l'espace agence (choisissez-en un vous-même)
AGENCE_PIN=

# URLs de votre site une fois déployé
CANCEL_URL=https://votre-site.com/paiement-annule
RETURN_URL=https://votre-site.com/paiement-confirme
CALLBACK_URL=https://votre-backend.com/api/webhook/paydunya

# Fichier de base de données SQLite (laissez tel quel en local)
DB_PATH=./visassistance.db

PORT=3001
